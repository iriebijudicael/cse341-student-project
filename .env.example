# MongoDB connection string for your local or Atlas database
# Replace with your own connection URI.

# Local MongoDB example:
# MONGODB_URL=mongodb://localhost:27017/cse341

# Atlas example:
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cse341?retryWrites=true&w=majority

# Optional: database name if you want to separate it from the URI
# MONGODB_DB_NAME=cse341

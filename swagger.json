{
  "swagger": "2.0",
  "info": {
    "title": "Contacts API",
    "description": "CSE341 Contacts Project API Documentation for Week 02 CRUD Operations",
    "version": "1.0.0"
  },
  "host": "https://cse341-student-project.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Home Page"
        ],
        "description": "Renders the dynamic MVC home dashboard layout.",
        "responses": {
          "200": {
            "description": "HTML Render Successful"
          }
        }
      }
    },
    "/contacts": {
      "get": {
        "tags": [
          "Contacts Resource"
        ],
        "description": "Retrieves all contact documents currently stored in the MongoDB cluster.",
        "responses": {
          "200": {
            "description": "Array of contact documents retrieved successfully"
          }
        }
      },
      "post": {
        "tags": [
          "Contacts Resource"
        ],
        "description": "Inserts a brand new contact document into the database collection. All payload keys are strictly required.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "type": "string", "example": "John" },
                "lastName": { "type": "string", "example": "Utah" },
                "email": { "type": "string", "example": "john225@gmail.com" },
                "favoriteColor": { "type": "string", "example": "white" },
                "birthday": { "type": "string", "example": "1995-04-23" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Document Created. Returns the unique string ID generated by MongoDB."
          },
          "500": {
            "description": "Internal Database Insertion Failure"
          }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "tags": [
          "Contacts Resource"
        ],
        "description": "Retrieves a singular contact document filtering by its precise database Hex-string ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The Hexadecimal string identifier string of the document"
          }
        ],
        "responses": {
          "200": {
            "description": "Targeted document matching ID retrieved"
          }
        }
      },
      "put": {
        "tags": [
          "Contacts Resource"
        ],
        "description": "Overwrites an existing contact document completely using a full schema replacement payload.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The Hexadecimal string identifier of the document to modify"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "type": "string", "example": "John" },
                "lastName": { "type": "string", "example": "Utah" },
                "email": { "type": "string", "example": "johnupdated@gmail.com" },
                "favoriteColor": { "type": "string", "example": "blue" },
                "birthday": { "type": "string", "example": "1995-04-23" }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Document Modified Successfully. No content returned."
          },
          "500": {
            "description": "Modification Failure or Hex ID non-existent"
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts Resource"
        ],
        "description": "Removes a specific contact document permanently from the collection cluster matching the criteria ID parameter.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The target document identifier string"
          }
        ],
        "responses": {
          "204": {
            "description": "Document Purged Successfully. No payload returned."
          },
          "500": {
            "description": "Target ID missing or purge operation dropped"
          }
        }
      }
    }
  }
}
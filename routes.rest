### -------------------------------------------------------------------------
### USERS COLLECTION - LOCAL
### -------------------------------------------------------------------------

### Get all users
GET http://localhost:5500/users

### Get user by ID (Replace with a valid ID from your local database)
GET http://localhost:5500/users/660a1234567890abcdef1234

### Create a new user account
POST http://localhost:5500/users
Content-Type: application/json

{
  "firstName": "Kevine",
  "lastName": "Kouke",
  "email": "koukekevine@example.com",
  "role": "customer"
}

### Update user parameters (Replace URL ID with the ID created from POST)
PUT http://localhost:5500/users/6a281746b18d357bbd9be979
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe Janson",
  "email": "johndoe_janson23@example.com",
  "role": "admin"
}

### Delete a user account (Replace URL ID with a valid database ID)
DELETE http://localhost:5500/users/660a1234567890abcdef1234


### -------------------------------------------------------------------------
### PRODUCTS COLLECTION - LOCAL
### -------------------------------------------------------------------------

### Fetch complete product catalog
GET http://localhost:5500/products

### Get product specifications by ID
GET http://localhost:5500/products/660b9876543210fedcba4321

### Add a new product to the catalog
POST http://localhost:5500/products
Content-Type: application/json

{
  "title": "Gaming Mouse Pro",
  "description": "High precision wireless gaming mouse with customizable DPI settings.",
  "category": "Electronics",
  "price": 12.08,
  "stock": 150
}

### Modify product details (Replace URL ID with the ID created from POST)
PUT http://localhost:5500/products/660b9876543210fedcba4321
Content-Type: application/json

{
  "title": "Wireless Gaming Mouse v2",
  "description": "Upgraded battery life ergonomic wireless mouse.",
  "category": "Electronics",
  "price": 64.99,
  "stock": 95
}

### Remove a product item from listings
DELETE http://localhost:5500/products/660b9876543210fedcba4321




